{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "OFFLINE STRUCTURAL VALIDATION ONLY - placeholder artifacts, DO NOT DEPLOY",
  "Parameters": {
    "ProjectName": {
      "Type": "String",
      "Default": "smart-expense",
      "AllowedPattern": "[a-z][a-z0-9-]{2,24}"
    },
    "FrontendOrigin": {
      "Type": "String",
      "AllowedPattern": "https://[a-zA-Z0-9.-]+",
      "Description": "Exact Amplify HTTPS origin, without trailing slash"
    },
    "PrivateEmailEnabled": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "false",
        "true"
      ],
      "Description": "Enable only after the documented account/IAM and two-user isolation checks"
    }
  },
  "Rules": {
    "SydneyOnly": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "AWS::Region"
              },
              "ap-southeast-2"
            ]
          },
          "AssertDescription": "Deploy in Sydney"
        }
      ]
    }
  },
  "Resources": {
    "UserDomain": {
      "Type": "AWS::Cognito::UserPoolDomain",
      "Properties": {
        "Domain": {
          "Fn::Sub": "${ProjectName}-${AWS::AccountId}"
        },
        "UserPoolId": {
          "Ref": "Users"
        },
        "ManagedLoginVersion": 2
      }
    },
    "WeeklySchedule": {
      "Type": "AWS::Scheduler::Schedule",
      "Properties": {
        "GroupName": {
          "Ref": "ScheduleGroup"
        },
        "ScheduleExpression": "cron(0 9 ? * MON *)",
        "ScheduleExpressionTimezone": "Australia/Sydney",
        "FlexibleTimeWindow": {
          "Mode": "OFF"
        },
        "State": "ENABLED",
        "Target": {
          "Arn": {
            "Fn::GetAtt": [
              "SummaryFunction",
              "Arn"
            ]
          },
          "RoleArn": {
            "Fn::GetAtt": [
              "SchedulerRole",
              "Arn"
            ]
          },
          "Input": "{\"scheduledTime\":\"<aws.scheduler.scheduled-time>\"}",
          "RetryPolicy": {
            "MaximumEventAgeInSeconds": 21600,
            "MaximumRetryAttempts": 2
          }
        }
      }
    },
    "Alerts": {
      "Type": "AWS::SNS::Topic",
      "Properties": {
        "TopicName": {
          "Fn::Sub": "${ProjectName}-expense-alerts"
        }
      }
    },
    "ApiFunctionLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${ProjectName}-expense-api"
        },
        "RetentionInDays": 14
      }
    },
    "ReceiptPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "Receipts"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenyInsecureTransport",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "Receipts",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${Receipts.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "ProcessorRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ReceiptData",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:Query"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Expenses",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Budgets",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "sns:Publish",
                    "sns:ListSubscriptionsByTopic",
                    "sns:GetSubscriptionAttributes"
                  ],
                  "Resource": {
                    "Ref": "Alerts"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObjectVersion",
                    "s3:DeleteObjectVersion"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${ProjectName}-${AWS::AccountId}-${AWS::Region}-receipts/receipts/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "textract:AnalyzeExpense",
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/${ProjectName}-receipt-processor:*"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Users": {
      "Type": "AWS::Cognito::UserPool",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "UserPoolName": {
          "Fn::Sub": "${ProjectName}-users"
        },
        "UserPoolTier": "ESSENTIALS",
        "UsernameAttributes": [
          "email"
        ],
        "AutoVerifiedAttributes": [
          "email"
        ],
        "UsernameConfiguration": {
          "CaseSensitive": false
        },
        "Policies": {
          "PasswordPolicy": {
            "MinimumLength": 12,
            "RequireLowercase": true,
            "RequireUppercase": true,
            "RequireNumbers": true,
            "RequireSymbols": true
          }
        },
        "AccountRecoverySetting": {
          "RecoveryMechanisms": [
            {
              "Name": "verified_email",
              "Priority": 1
            }
          ]
        },
        "UserAttributeUpdateSettings": {
          "AttributesRequireVerificationBeforeUpdate": [
            "email"
          ]
        }
      }
    },
    "ApiFunctionGetBudgetPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "ApiFunction"
        },
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": [
            "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${__ApiId__}/${__Stage__}/GET/budget",
            {
              "__ApiId__": {
                "Ref": "Api"
              },
              "__Stage__": "*"
            }
          ]
        }
      }
    },
    "ApiFunctionCreatePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "ApiFunction"
        },
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": [
            "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${__ApiId__}/${__Stage__}/POST/expenses",
            {
              "__ApiId__": {
                "Ref": "Api"
              },
              "__Stage__": "*"
            }
          ]
        }
      }
    },
    "ProcessorNotificationFailures": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "LogGroupName": {
          "Ref": "ProcessorLogs"
        },
        "FilterPattern": "?notification_blocked_or_failed ?notification_delivery_unknown ?budget_check_failed ?receipt_failure_state_unavailable",
        "MetricTransformations": [
          {
            "MetricNamespace": "SmartExpense",
            "MetricName": {
              "Fn::Sub": "${ProjectName}-notification-failures"
            },
            "MetricValue": "1"
          }
        ]
      }
    },
    "AlertsPolicy": {
      "Type": "AWS::SNS::TopicPolicy",
      "Properties": {
        "Topics": [
          {
            "Ref": "Alerts"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "OnlyApplicationPublishers",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "sns:Publish",
              "Resource": {
                "Ref": "Alerts"
              },
              "Condition": {
                "ArnNotEquals": {
                  "aws:PrincipalArn": [
                    {
                      "Fn::GetAtt": [
                        "ApiRole",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::GetAtt": [
                        "ProcessorRole",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::GetAtt": [
                        "SummaryRole",
                        "Arn"
                      ]
                    }
                  ]
                }
              }
            },
            {
              "Sid": "OnlyCoordinatedSubscriptions",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "sns:Subscribe",
              "Resource": {
                "Ref": "Alerts"
              },
              "Condition": {
                "ArnNotEquals": {
                  "aws:PrincipalArn": {
                    "Fn::GetAtt": [
                      "ApiRole",
                      "Arn"
                    ]
                  }
                }
              }
            }
          ]
        }
      }
    },
    "NotificationFailures": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "LogGroupName": {
          "Ref": "ApiFunctionLogs"
        },
        "FilterPattern": "?notification_blocked_or_failed ?notification_delivery_unknown ?budget_check_failed ?api_failure",
        "MetricTransformations": [
          {
            "MetricNamespace": "SmartExpense",
            "MetricName": {
              "Fn::Sub": "${ProjectName}-notification-failures"
            },
            "MetricValue": "1"
          }
        ]
      }
    },
    "Api": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Properties": {
        "Body": {
          "info": {
            "version": "1.0",
            "title": {
              "Ref": "AWS::StackName"
