{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageFunctionsAndTriggers",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:DeleteFunction",
        "lambda:GetPolicy",
        "lambda:RemovePermission",
        "lambda:TagResource",
        "lambda:UntagResource",
        "lambda:ListTags",
        "lambda:PutFunctionEventInvokeConfig",
        "lambda:GetFunctionEventInvokeConfig",
        "lambda:UpdateFunctionEventInvokeConfig",
        "lambda:DeleteFunctionEventInvokeConfig"
      ],
      "Resource": [
        "arn:aws:lambda:ap-southeast-2:296280725059:function:smart-expense-expense-api",
        "arn:aws:lambda:ap-southeast-2:296280725059:function:smart-expense-receipt-processor",
        "arn:aws:lambda:ap-southeast-2:296280725059:function:smart-expense-weekly-summary"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "ManageLatestEventInvokeConfigs",
      "Effect": "Allow",
      "Action": [
        "lambda:PutFunctionEventInvokeConfig",
        "lambda:GetFunctionEventInvokeConfig",
        "lambda:UpdateFunctionEventInvokeConfig",
        "lambda:DeleteFunctionEventInvokeConfig"
      ],
      "Resource": [
        "arn:aws:lambda:ap-southeast-2:296280725059:function:smart-expense-expense-api:$LATEST",
        "arn:aws:lambda:ap-southeast-2:296280725059:function:smart-expense-receipt-processor:$LATEST",
        "arn:aws:lambda:ap-southeast-2:296280725059:function:smart-expense-weekly-summary:$LATEST"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "OnlyApiGatewayAndS3InvocationGrants",
      "Effect": "Allow",
      "Action": ["lambda:AddPermission"],
      "Resource": [
        "arn:aws:lambda:ap-southeast-2:296280725059:function:smart-expense-expense-api",
        "arn:aws:lambda:ap-southeast-2:296280725059:function:smart-expense-receipt-processor",
        "arn:aws:lambda:ap-southeast-2:296280725059:function:smart-expense-weekly-summary"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2",
          "lambda:Principal": ["apigateway.amazonaws.com", "s3.amazonaws.com"]
        }
      }
    },
    {
      "Sid": "ManageScheduleGroup",
      "Effect": "Allow",
      "Action": [
        "scheduler:CreateScheduleGroup",
        "scheduler:GetScheduleGroup",
        "scheduler:DeleteScheduleGroup",
        "scheduler:ListTagsForResource",
        "scheduler:TagResource",
        "scheduler:UntagResource"
      ],
      "Resource": "arn:aws:scheduler:ap-southeast-2:296280725059:schedule-group/ict5205-expenses-ScheduleGroup-*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "ManageWeeklySchedule",
      "Effect": "Allow",
      "Action": [
        "scheduler:CreateSchedule",
        "scheduler:GetSchedule",
        "scheduler:UpdateSchedule",
        "scheduler:DeleteSchedule"
      ],
      "Resource": "arn:aws:scheduler:ap-southeast-2:296280725059:schedule/ict5205-expenses-ScheduleGroup-*/ict5205-expenses-WeeklySchedule-*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "DeleteSchedulesInApplicationGroup",
      "Effect": "Allow",
      "Action": ["scheduler:DeleteSchedule"],
      "Resource": "arn:aws:scheduler:ap-southeast-2:296280725059:schedule/ict5205-expenses-ScheduleGroup-*/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "ManageLogGroupsAndFilters",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy",
        "logs:DeleteRetentionPolicy",
        "logs:PutMetricFilter",
        "logs:DeleteMetricFilter",
        "logs:DescribeMetricFilters",
        "logs:TagResource",
        "logs:UntagResource",
        "logs:ListTagsForResource",
        "logs:TagLogGroup",
        "logs:UntagLogGroup",
        "logs:ListTagsLogGroup"
      ],
      "Resource": [
        "arn:aws:logs:ap-southeast-2:296280725059:log-group:/aws/lambda/smart-expense-expense-api",
        "arn:aws:logs:ap-southeast-2:296280725059:log-group:/aws/lambda/smart-expense-expense-api:*",
        "arn:aws:logs:ap-southeast-2:296280725059:log-group:/aws/lambda/smart-expense-receipt-processor",
        "arn:aws:logs:ap-southeast-2:296280725059:log-group:/aws/lambda/smart-expense-receipt-processor:*",
        "arn:aws:logs:ap-southeast-2:296280725059:log-group:/aws/lambda/smart-expense-weekly-summary",
        "arn:aws:logs:ap-southeast-2:296280725059:log-group:/aws/lambda/smart-expense-weekly-summary:*",
        "arn:aws:logs:ap-southeast-2:296280725059:log-group:ict5205-expenses-ApiLogs-*",
        "arn:aws:logs:ap-southeast-2:296280725059:log-group:ict5205-expenses-ApiLogs-*:*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "ApiAccessLogDelivery",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups",
        "logs:CreateLogDelivery",
        "logs:GetLogDelivery",
        "logs:UpdateLogDelivery",
        "logs:DeleteLogDelivery",
        "logs:ListLogDeliveries",
        "logs:PutResourcePolicy",
        "logs:DescribeResourcePolicies"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "ManageApplicationAlarms",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricAlarm",
        "cloudwatch:DescribeAlarms",
        "cloudwatch:DeleteAlarms",
        "cloudwatch:TagResource",
        "cloudwatch:UntagResource",
        "cloudwatch:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:cloudwatch:ap-southeast-2:296280725059:alarm:ict5205-expenses-ProcessorErrors-*",
        "arn:aws:cloudwatch:ap-southeast-2:296280725059:alarm:ict5205-expenses-ApiErrors-*",
        "arn:aws:cloudwatch:ap-southeast-2:296280725059:alarm:ict5205-expenses-SummaryErrors-*",
        "arn:aws:cloudwatch:ap-southeast-2:296280725059:alarm:ict5205-expenses-NotificationAlarm-*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    }
  ]
}
