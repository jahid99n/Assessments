{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateBoundedApiRole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePermissionsBoundary",
        "iam:PutRolePolicy",
        "iam:UpdateAssumeRolePolicy"
      ],
      "Resource": "arn:aws:iam::296280725059:role/ict5205-expenses-ApiRole-*",
      "Condition": {
        "ArnEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::296280725059:policy/ExpenseTracker-ApiRole-Boundary"
        }
      }
    },
    {
      "Sid": "CreateBoundedProcessorRole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePermissionsBoundary",
        "iam:PutRolePolicy",
        "iam:UpdateAssumeRolePolicy"
      ],
      "Resource": "arn:aws:iam::296280725059:role/ict5205-expenses-ProcessorRole-*",
      "Condition": {
        "ArnEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::296280725059:policy/ExpenseTracker-ProcessorRole-Boundary"
        }
      }
    },
    {
      "Sid": "CreateBoundedSummaryRole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePermissionsBoundary",
        "iam:PutRolePolicy",
        "iam:UpdateAssumeRolePolicy"
      ],
      "Resource": "arn:aws:iam::296280725059:role/ict5205-expenses-SummaryRole-*",
      "Condition": {
        "ArnEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::296280725059:policy/ExpenseTracker-SummaryRole-Boundary"
        }
      }
    },
    {
      "Sid": "CreateBoundedSchedulerRole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePermissionsBoundary",
        "iam:PutRolePolicy",
        "iam:UpdateAssumeRolePolicy"
      ],
      "Resource": "arn:aws:iam::296280725059:role/ict5205-expenses-SchedulerRole-*",
      "Condition": {
        "ArnEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::296280725059:policy/ExpenseTracker-SchedulerRole-Boundary"
        }
      }
    },
    {
      "Sid": "ManageOnlyApplicationRoles",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:DeleteRole",
        "iam:UpdateRole",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:ListRoleTags"
      ],
      "Resource": [
        "arn:aws:iam::296280725059:role/ict5205-expenses-ApiRole-*",
        "arn:aws:iam::296280725059:role/ict5205-expenses-ProcessorRole-*",
        "arn:aws:iam::296280725059:role/ict5205-expenses-SummaryRole-*",
        "arn:aws:iam::296280725059:role/ict5205-expenses-SchedulerRole-*"
      ]
    },
    {
      "Sid": "PassLambdaRoles",
      "Effect": "Allow",
      "Action": ["iam:PassRole"],
      "Resource": [
        "arn:aws:iam::296280725059:role/ict5205-expenses-ApiRole-*",
        "arn:aws:iam::296280725059:role/ict5205-expenses-ProcessorRole-*",
        "arn:aws:iam::296280725059:role/ict5205-expenses-SummaryRole-*"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "PassSchedulerRole",
      "Effect": "Allow",
      "Action": ["iam:PassRole"],
      "Resource": "arn:aws:iam::296280725059:role/ict5205-expenses-SchedulerRole-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "scheduler.amazonaws.com"
        }
      }
    },
    {
      "Sid": "NeverRemoveRuntimeBoundaries",
      "Effect": "Deny",
      "Action": "iam:DeleteRolePermissionsBoundary",
      "Resource": [
        "arn:aws:iam::296280725059:role/ict5205-expenses-ApiRole-*",
        "arn:aws:iam::296280725059:role/ict5205-expenses-ProcessorRole-*",
        "arn:aws:iam::296280725059:role/ict5205-expenses-SummaryRole-*",
        "arn:aws:iam::296280725059:role/ict5205-expenses-SchedulerRole-*"
      ]
    }
  ]
}
