      "Properties": {
        "LogGroupName": {
          "Ref": "ApiFunctionLogs"
        },
        "FilterPattern": "?notification_blocked_or_failed ?notification_delivery_unknown ?budget_check_failed ?api_failure",
        "MetricTransformations": [
          {
            "MetricNamespace": "SmartExpense",
            "MetricName": {
              "Fn::Sub": "${ProjectName}-notification-failures"
            },
            "MetricValue": "1"
          }
        ]
      }
    },
    "ProcessorNotificationFailures": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "LogGroupName": {
          "Ref": "ProcessorLogs"
        },
        "FilterPattern": "?notification_blocked_or_failed ?notification_delivery_unknown ?budget_check_failed ?receipt_failure_state_unavailable",
        "MetricTransformations": [
          {
            "MetricNamespace": "SmartExpense",
            "MetricName": {
              "Fn::Sub": "${ProjectName}-notification-failures"
            },
            "MetricValue": "1"
          }
        ]
      }
    },
    "SummaryNotificationFailures": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "LogGroupName": {
          "Ref": "SummaryLogs"
        },
        "FilterPattern": "?notification_blocked_or_failed ?notification_delivery_unknown ?weekly_user_failed",
        "MetricTransformations": [
          {
            "MetricNamespace": "SmartExpense",
            "MetricName": {
              "Fn::Sub": "${ProjectName}-notification-failures"
            },
            "MetricValue": "1"
          }
        ]
      }
    },
    "NotificationAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "Namespace": "SmartExpense",
        "MetricName": {
          "Fn::Sub": "${ProjectName}-notification-failures"
        },
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching"
      }
    },
    "ApiErrors": {
