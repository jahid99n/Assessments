{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateHttpApi",
      "Effect": "Allow",
      "Action": ["apigateway:POST", "apigateway:PUT"],
      "Resource": "arn:aws:apigateway:ap-southeast-2::/apis",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "ManageInitiallyUnknownHttpApi",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET",
        "apigateway:PUT",
        "apigateway:PATCH",
        "apigateway:DELETE"
      ],
      "Resource": "arn:aws:apigateway:ap-southeast-2::/apis/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "ManageInitiallyUnknownHttpApiCollections",
      "Effect": "Allow",
      "Action": ["apigateway:GET", "apigateway:POST"],
      "Resource": [
        "arn:aws:apigateway:ap-southeast-2::/apis/*/authorizers",
        "arn:aws:apigateway:ap-southeast-2::/apis/*/integrations",
        "arn:aws:apigateway:ap-southeast-2::/apis/*/routes",
        "arn:aws:apigateway:ap-southeast-2::/apis/*/stages"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "ManageInitiallyUnknownHttpApiChildren",
      "Effect": "Allow",
      "Action": ["apigateway:GET", "apigateway:PATCH", "apigateway:DELETE"],
      "Resource": [
        "arn:aws:apigateway:ap-southeast-2::/apis/*/authorizers/*",
        "arn:aws:apigateway:ap-southeast-2::/apis/*/integrations/*",
        "arn:aws:apigateway:ap-southeast-2::/apis/*/routes/*",
        "arn:aws:apigateway:ap-southeast-2::/apis/*/stages/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    },
    {
      "Sid": "CreateTaggedUserPool",
      "Effect": "Allow",
      "Action": ["cognito-idp:CreateUserPool"],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2",
          "aws:RequestTag/Deployment": "ict5205-expenses"
        }
      }
    },
    {
      "Sid": "ManageInitiallyUnknownUserPool",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:DescribeUserPool",
        "cognito-idp:UpdateUserPool",
        "cognito-idp:DeleteUserPool",
        "cognito-idp:GetUserPoolMfaConfig",
        "cognito-idp:SetUserPoolMfaConfig",
        "cognito-idp:CreateUserPoolClient",
        "cognito-idp:DescribeUserPoolClient",
        "cognito-idp:UpdateUserPoolClient",
        "cognito-idp:DeleteUserPoolClient",
        "cognito-idp:CreateUserPoolDomain",
        "cognito-idp:UpdateUserPoolDomain",
        "cognito-idp:DeleteUserPoolDomain",
        "cognito-idp:CreateManagedLoginBranding",
        "cognito-idp:DescribeManagedLoginBranding",
        "cognito-idp:DescribeManagedLoginBrandingByClient",
        "cognito-idp:UpdateManagedLoginBranding",
        "cognito-idp:DeleteManagedLoginBranding",
        "cognito-idp:TagResource",
        "cognito-idp:UntagResource",
        "cognito-idp:ListTagsForResource"
      ],
      "Resource": "arn:aws:cognito-idp:ap-southeast-2:296280725059:userpool/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2",
          "aws:ResourceTag/Deployment": "ict5205-expenses"
        }
      }
    },
    {
      "Sid": "BootstrapApiGatewayServiceRole",
      "Effect": "Allow",
      "Action": ["iam:CreateServiceLinkedRole"],
      "Resource": "arn:aws:iam::296280725059:role/aws-service-role/ops.apigateway.amazonaws.com/AWSServiceRoleForAPIGateway",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": "ops.apigateway.amazonaws.com"
        }
      }
    }
  ]
}
